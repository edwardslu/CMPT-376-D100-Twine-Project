[[Recommend wording changes while keeping the existing behavior->LimitedRedesign]]
</div></div></div>


:: SmallerProject {"position":"525,25","size":"100,100"}
<div class="passage-shell" data-scene="office" data-typing="false"><div class="scene-hero" role="img" aria-label="An empty modern office at Amaze."></div><p class="photo-credit">Photo: <a href="https://www.pexels.com/photo/an-empty-office-5483236/" target="_blank" rel="noopener">cottonbro studio / Pexels</a></p><div class="story-copy"><p class="kicker">04 / THE PRESSURE</p><h1>The request returns</h1><p>You spend the next two weeks fixing product-page bugs. The work is useful, but Morgan repeatedly asks when you will take on Sub and Save.</p><blockquote>“We need people who take ownership,” Morgan says during your check-in. “If you won’t do it, another developer can. Or someone can use an AI tool to draft the code.”</blockquote><p>Your refusal alone will not prevent the launch. Agreeing would give you influence over implementation, but Morgan still wants the same default.</p><p>You must answer.</p><div class="choices">
[[Relent and agree to implement it->Implementation]]
[[Refuse the request again->BadEnding2]]
</div></div></div>


:: Start {"position":"25,25","size":"100,100"}
(set: $raisedConcern to false)
(set: $clearDesign to false)
<div class="passage-shell" data-scene="graduation" data-typing="false"><div class="scene-hero" role="img" aria-label="A graduation cap and diploma."></div><p class="photo-credit">Photo: <a href="https://www.pexels.com/photo/photo-of-person-holding-graduation-cap-and-diploma-7944064/" target="_blank" rel="noopener">Pavel Danilyuk / Pexels</a></p><div class="story-copy"><p class="kicker">Introduction</p><h1>Story name<h1><p class="deck">An interactive story about subscription design.</p></h1><p>You play as <strong>Alex</strong>, a recent graduate starting work at <strong>Amaze</strong>, a fictional online store. Your manager needs more repeat customers. Your customers need to understand what they are choosing.</p><div class="callout"><strong>How to play</strong><p>Read each scene and choose an action. There is no timer or score. Different choices reveal different consequences. Sound is optional; use the control above.</p></div><div class="credits-mini"><strong>Team 24 · CMPT 376W G1</strong><p>Edward Lu — <em>role to confirm</em><br>Oak Soe Khant — <em>role to confirm</em><br>Wonchan Kim — <em>role to confirm</em></p><p>Based on ACM’s <a href="https://ethics.acm.org/code-of-ethics/using-the-code/case-dark-ux-patterns/" target="_blank" rel="noopener">Dark UX Patterns</a> case study. All characters, company events, prices, and legal proceedings in this story are fictional.</p></div><div class="choices">
[[Begin the story->Graduation]]
[[Media and project credits->Credits]]
</div></div></div>


:: StoryScript [script]
(function(){
'use strict';
let enabled=false, activeShell=null, volume=0.22;
const onlinePreview=location.protocol!=='file:'&&/twinery\.org$/.test(location.hostname);
const base=onlinePreview?'https://assets.mixkit.co/active_storage/sfx/':null;
const ambience=new Audio(base?base+'447/447.wav':'assets/office-ambience.wav');
const typing=new Audio(base?base+'2531/2531.wav':'assets/typing.wav');
ambience.loop=true;ambience.preload='none';typing.preload='none';
let typingTimer;
function init(){
 if(document.querySelector('.global-bar'))return;
 const bar=document.createElement('header');bar.className='global-bar';bar.innerHTML='<div class="brand">Story Name<small>CMPT 376W · Draft story flow</small></div><div class="global-controls"><button id="sound-toggle" type="button" aria-pressed="false">Sound: off</button><label>Volume <input id="sound-volume" type="range" min="0" max="100" value="22" aria-label="Sound volume"></label><button id="restart-story" type="button">Restart</button><span class="audio-status" aria-live="polite">Sound is optional</span></div>';document.body.prepend(bar);
 const foot=document.createElement('footer');foot.className='global-footer';foot.innerHTML='<span>AMAZE</span> · A fictional adaptation of ACM’s Dark UX Patterns · Team 24';document.body.append(foot);
 document.querySelector('#sound-toggle').addEventListener('click',()=>{enabled=!enabled;document.querySelector('#sound-toggle').textContent='Sound: '+(enabled?'on':'off');document.querySelector('#sound-toggle').setAttribute('aria-pressed',String(enabled));syncAudio(true);});
 document.querySelector('#sound-volume').addEventListener('input',e=>{volume=Number(e.target.value)/100;ambience.volume=volume*.55;typing.volume=volume*.7;});
 document.querySelector('#restart-story').addEventListener('click',()=>location.reload());
 document.addEventListener('visibilitychange',()=>{if(document.hidden){ambience.pause();typing.pause();}else syncAudio(false);});
 new MutationObserver(updateScene).observe(document.querySelector('tw-story')||document.body,{childList:true,subtree:true});updateScene();
}
function syncAudio(userAction){
 clearTimeout(typingTimer);typing.pause();
 if(!enabled||document.hidden){ambience.pause();status(enabled?'Paused while away':'Sound is optional');return;}
 const isOffice=activeShell&&activeShell.dataset.scene==='office';
 if(isOffice){ambience.volume=volume*.55;ambience.play().then(()=>status('Office ambience')).catch(()=>status('Audio unavailable; story still works'));}
 else{ambience.pause();status('Sound on · quiet scene');}
 if(isOffice&&activeShell.dataset.typing==='true'){
  typing.currentTime=0;typing.volume=volume*.7;typing.play().catch(()=>{});typingTimer=setTimeout(()=>typing.pause(),3500);
 }
}
function status(s){const el=document.querySelector('.audio-status');if(el&&el.textContent!==s)el.textContent=s;}
function updateScene(){const shells=document.querySelectorAll('tw-passage .passage-shell');const shell=shells[shells.length-1];if(!shell||shell===activeShell)return;activeShell=shell;document.body.dataset.scene=shell.dataset.scene;syncAudio(false);window.scrollTo({top:0,behavior:'instant'});}
if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',init);else init();
})();

:: StoryStylesheet [stylesheet]
:root{--scene-image:var(--photo-office)}
*{box-sizing:border-box}html,body{background:#eeeeea;color:#222;margin:0;font-family:Arial,sans-serif;font-size:17px;line-height:1.6}
body[data-scene=graduation]{--scene-image:var(--photo-graduation)}body[data-scene=office]{--scene-image:var(--photo-office)}body[data-scene=rain]{--scene-image:var(--photo-rain)}body[data-scene=deliveries]{--scene-image:var(--photo-deliveries)}
tw-story{font-family:Arial,sans-serif;display:block;width:calc(100% - 32px);max-width:680px;margin:20px auto;padding:0;background:white;color:#222;font-size:17px;line-height:1.6;border:1px solid #ccc}tw-sidebar{display:none}tw-passage{display:block}.scene-hero{height:150px;background:var(--scene-image) center/cover no-repeat}.photo-credit{font-size:12px;margin:5px 20px;color:#555}.story-copy{padding:14px 20px 22px}.kicker{font-size:13px;color:#666;margin:0 0 8px}h1{font-size:28px;line-height:1.3;margin:0 0 18px}h2{font-size:20px;margin-top:24px}p{margin:0 0 16px}.deck{font-size:18px}.callout{border-left:3px solid #aaa;padding:10px 14px;background:#f3f3f3;margin:18px 0}.callout p{margin:6px 0}blockquote{margin:18px 0;padding-left:16px;border-left:2px solid #bbb}.choices{margin-top:24px;border-top:1px solid #ddd;padding-top:10px}.choices tw-link{display:block;color:#245a91;text-decoration:underline;font-weight:normal;padding:6px 0}.choices br{display:none}a{color:#245a91}a:hover,tw-link:hover{color:#163a60}a:focus-visible,tw-link:focus-visible,button:focus-visible{outline:2px solid #245a91;outline-offset:3px}.credits-mini{font-size:14px;border-top:1px solid #ccc;padding-top:12px;margin-top:20px}.checkout{border:1px solid #aaa;background:#fafafa;padding:16px;max-width:400px;margin:20px 0}.checkout strong,.mini-label{display:block}.mini-label,.muted{font-size:12px}.price{font-size:24px}.price small{font-size:14px}.selected-option{background:#e7eee1;padding:6px}.fake-button{background:#e5c578;text-align:center;padding:5px;max-width:150px}.ending-label{font-weight:bold;margin:12px 0}.acm-line{font-size:13px;color:#555}dt{font-weight:bold;margin-top:15px}dd{margin:5px 0 14px}li{margin-bottom:8px}.global-bar{max-width:740px;margin:20px auto 0;padding:0 16px;font-size:14px}.brand{font-weight:bold}.brand small{font-weight:normal;display:block}.global-controls{display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-top:10px}.global-controls button{padding:4px 9px;font:inherit;cursor:pointer}.global-controls input{width:70px}.audio-status{font-size:12px;color:#555}.global-footer{text-align:center;font-size:12px;color:#555;margin:16px}tw-error{font-size:16px}
@media(max-width:550px){.story-copy{padding:16px}.scene-hero{height:155px}h1{font-size:25px}}

